<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1762300000124</Id>
<Name><![CDATA[pickFont]]></Name>
<Description><![CDATA[Chooses the board typeface and applies it to every text drawn by the model.]]></Description>
<X>1850</X><Y>416</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[// one mono face for the whole screen: fonts shipped in data/fonts are registered first, then the first installed one wins
java.io.File[] files = new java.io.File("data/fonts").listFiles();
if (files != null) {
	for (java.io.File f : files) {
		String n = f.getName().toLowerCase();
		if (!n.endsWith(".ttf") && !n.endsWith(".otf")) continue;
		try {
			java.awt.GraphicsEnvironment.getLocalGraphicsEnvironment().registerFont(Font.createFont(Font.TRUETYPE_FONT, f));
		} catch (Exception e) {
			traceln("font " + f.getName() + " not loaded: " + e.getMessage());
		}
	}
}
String[] want = {"Chivo Mono", "JetBrains Mono", "IBM Plex Mono", "DM Mono", "Cascadia Mono", "Consolas", "DejaVu Sans Mono", "Monospaced"};
Set<String> have = new HashSet<String>(Arrays.asList(java.awt.GraphicsEnvironment.getLocalGraphicsEnvironment().getAvailableFontFamilyNames()));
for (String f : want) {
	if (have.contains(f)) {
		uiFont = f;
		break;
	}
}
restyle(presentation);]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1762300000125</Id>
<Name><![CDATA[restyle]]></Name>
<X>1850</X><Y>438</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[g]]></Name>
<Type><![CDATA[ShapeGroup]]></Type>
</Parameter>
<Body><![CDATA[for (int i = 0; i < g.size(); i++) {
	Object o = g.get(i);
	if (o instanceof ShapeText) {
		ShapeText t = (ShapeText) o;
		Font f = t.getFont();
		if (f != null) t.setFont(new Font(uiFont, f.getStyle(), f.getSize()));
	} else if (o instanceof ShapeGroup) {
		restyle((ShapeGroup) o);
	}
}]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
