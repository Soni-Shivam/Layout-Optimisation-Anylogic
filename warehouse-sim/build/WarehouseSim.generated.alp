<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[String]]></ReturnType>
<Id>1762300000141</Id>
<Name><![CDATA[figValue]]></Name>
<Description><![CDATA[The three figures layouts are compared on.]]></Description>
<X>1850</X><Y>790</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[i]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[if (wh == null) return "\u2013";
double[] v = liveKpi();
switch (i) {
	case 0: return Double.isNaN(walkPerOrder()) ? "\u2013" : String.format("%.0f m", walkPerOrder());
	case 1: return Double.isNaN(v[0]) ? "\u2013" : String.format("%.0f min", v[0]);
	default: return Double.isNaN(v[1]) ? "\u2013" : String.format("%.0f%%", v[1]);
}]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[String]]></ReturnType>
<Id>1762300000142</Id>
<Name><![CDATA[figNote]]></Name>
<X>1850</X><Y>812</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[i]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[if (wh == null) return "";
double[] v = liveKpi();
switch (i) {
	case 0: return kpi.tours > 0 ? String.format("%.1f km, %d carts", kpi.tourM / 1000, kpi.tours) : "no cart back yet";
	case 1: return nPacked > 0 ? "mean of " + nPacked + " orders" : "none packed yet";
	default: return (int) v[2] > 0 ? "of " + (int) v[2] + " orders due" : "no cut-off yet";
}]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[int]]></ReturnType>
<Id>1762300000143</Id>
<Name><![CDATA[boardNow]]></Name>
<Description><![CDATA[Orders at board row i now: held, waiting for a cart, on a cart, packing, staging.]]></Description>
<X>1850</X><Y>834</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[i]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[if (wh == null) return 0;
switch (i) {
	case 0: return (int) kpi.held.value();
	case 1: return pending.size();
	case 2: return pickPool.size() - pending.size();
	case 3: return nPicked - nPacked;
	default: return (int) kpi.staging.value();
}]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[String]]></ReturnType>
<Id>1762300000144</Id>
<Name><![CDATA[boardSoFar]]></Name>
<X>1850</X><Y>856</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[i]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[if (wh == null) return "";
double[] v = liveKpi();
switch (i) {
	case 0: return (int) v[3] + " held today";
	case 1: return (int) v[4] + " released";
	case 2: return nPicked + " picked";
	case 3: return nPacked + " packed";
	default: return nShipped + " shipped";
}]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[String]]></ReturnType>
<Id>1762300000145</Id>
<Name><![CDATA[crewText]]></Name>
<X>1850</X><Y>878</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[k]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[if (wh == null) return "";
ResourcePool[] pools = {pickerPool, packerPool, receiverPool, putawayPool};
return pools[k].busy() + " of " + staff[k] + " busy";]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1762300000146</Id>
<Name><![CDATA[crewBusyNow]]></Name>
<X>1850</X><Y>900</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[k]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[if (wh == null || staff[k] == 0) return 0;
ResourcePool[] pools = {pickerPool, packerPool, receiverPool, putawayPool};
return (double) pools[k].busy() / staff[k];]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[String]]></ReturnType>
<Id>1762300000147</Id>
<Name><![CDATA[inboundText]]></Name>
<X>1850</X><Y>922</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[if (wh == null) return "";
return String.format("Receiving buffer holds %d of %d lines.%n%,d units on the shelves.",
	(int) kpi.recvBuffer.value(), wh.recvBufferCapacity(), wh.inv.totalOnHand());]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1762300000148</Id>
<Name><![CDATA[endD]]></Name>
<X>1850</X><Y>944</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[key]]></Name>
<Type><![CDATA[String]]></Type>
</Parameter>
<Body><![CDATA[Object o = endS == null ? null : endS.get(key);
return o instanceof Number ? ((Number) o).doubleValue() : Double.NaN;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[String]]></ReturnType>
<Id>1762300000149</Id>
<Name><![CDATA[endLabel]]></Name>
<X>1850</X><Y>966</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[i]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[switch (i) {
	case 0: return "Orders shipped";
	case 1: return "Average fulfilment (arrival to packed)";
	case 2: return "95th percentile fulfilment";
	case 3: return "On time (packed by its cut-off)";
	case 4: return "Walk per picked order";
	case 5: return "Total picking walk";
	case 6: return "Carts";
	case 7: return "Orders held for stock";
	case 8: return "Utilisation: pickers / packers";
	case 9: return "Utilisation: receivers / putaway";
	default: return "";
}]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[String]]></ReturnType>
<Id>1762300000150</Id>
<Name><![CDATA[endText]]></Name>
<Description><![CDATA[Value column of the end-of-day panel (and the console table).]]></Description>
<X>1850</X><Y>988</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[i]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[if (endS == null) return "";
switch (i) {
	case 0: return String.format("%d of %d arrived", (int) endD("orders_shipped"), (int) endD("orders_arrived"));
	case 1: return String.format("%.1f min", endD("fulfil_mean_s") / 60);
	case 2: return String.format("%.1f min", endD("fulfil_p95_s") / 60);
	case 3: return String.format("%.1f %%", endD("on_time_pct"));
	case 4: return String.format("%.1f m", endD("pick_m_per_order"));
	case 5: return String.format("%.2f km", endD("pick_m_total") / 1000);
	case 6: return String.format("%d  (%.1f orders per cart)", (int) endD("tours"), endD("orders_per_tour"));
	case 7: return String.valueOf((int) endD("held_orders"));
	case 8: return String.format("%.0f %% / %.0f %%", 100 * endD("util_pick"), 100 * endD("util_pack"));
	case 9: return String.format("%.0f %% / %.0f %%", 100 * endD("util_recv"), 100 * endD("util_put"));
	default: return "";
}]]></Body>
</Function>
</Functions>
