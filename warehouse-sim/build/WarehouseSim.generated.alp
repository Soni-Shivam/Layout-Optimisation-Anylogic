<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[Worker u = workers.get(i);
double[] p = u.motion != null ? u.motion.at(time()) : homeXY(u);
double off = ((u.k % 3) - 1) * 0.35 * wh.layout.cellW;     // spread workers that share a spot
return new double[]{sx(p[0] + off), sy(p[1] + off)};]]></Body>
